{
  "manifest_version": 3,
  "name": "TabbyNotey",
  "version": "0.2.0",
  "description": "Leave notes on a page so you remember why you kept it open.",
  "permissions": ["tabs", "storage", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "TabbyNotey",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
